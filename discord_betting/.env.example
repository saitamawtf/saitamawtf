# ─── Discord ───────────────────────────────────────────────────────────────
# Bot token from discord.com/developers/applications → Bot → Token
DISCORD_TOKEN=your_discord_bot_token_here

# Comma-separated channel IDs to monitor (right-click channel → Copy ID)
# Requires Developer Mode enabled in Discord settings.
DISCORD_CHANNEL_IDS=123456789012345678,987654321098765432

# Optional: only forward messages from these usernames (comma-separated).
# Leave empty to accept messages from all users.
DISCORD_FILTER_AUTHORS=tipster_username,another_user

# Optional: only forward messages from users who have one of these role IDs.
# Leave empty to disable role filtering.
DISCORD_FILTER_ROLE_IDS=

# ─── Telegram ──────────────────────────────────────────────────────────────
# Token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram chat/channel ID.
# For personal chat: send a message to your bot, then call:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# to find your chat_id in the response.
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/bets.log
